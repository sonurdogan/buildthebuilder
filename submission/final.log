 "operations": [
  {
   "tool": "cards_list",
   "method": "POST",
   "path": "/voice/v1/cards.list",
   "purpose": "Returns the identified customer's active credit cards that the assistant may talk about (start of every call).",
   "headers": {},
   "params": [
    {
     "name": "customerNo",
     "in": "body",
     "type": "string",
     "required": true,
     "description": "8-digit customer number handed over by the IVR; string or number both accepted",
     "fill": "call_variable",
     "value": "customerNumber"
    },
    {
     "name": "aiFlow",
     "in": "body",
     "type": "string",
     "required": true,
     "enum": [
      "CardOps"
     ],
     "description": "Use case asking; \"CardOps\" for this flow (not validated in test)",
     "fill": "fixed",
     "value": "CardOps"
    }
   ],
   "responses": [
    {
     "status": 200,
